{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolphish.dev/schema/entry.schema.json",
  "title": "LOLPHISH Entry",
  "type": "object",
  "required": ["id", "name", "category", "vendors", "summary", "abuse",
               "variants", "kits", "surfaces", "attack", "detections",
               "mitigations", "refs", "since"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "lowercase-kebab-case, must match filename"
    },
    "name": { "type": "string", "minLength": 4 },
    "category": {
      "type": "string",
      "enum": ["Identity Flow Abuse", "User-Assisted Execution",
               "Trusted Delivery", "Reputation Laundering"]
    },
    "vendors":    { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "summary":    { "type": "string", "minLength": 40 },
    "abuse":      { "type": "string", "minLength": 80 },
    "variants":   { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "kits":       { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "surfaces":   { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "attack":     { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{4}" }, "minItems": 1 },
    "detections": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "detection_code": {
      "type": "array",
      "description": "Optional detection-as-code snippets (KQL, Sigma, Splunk, etc.)",
      "items": {
        "type": "object",
        "required": ["lang", "query"],
        "additionalProperties": false,
        "properties": {
          "lang": {
            "type": "string",
            "enum": ["kql", "sigma", "splunk", "yara", "generic"]
          },
          "query": { "type": "string", "minLength": 10 },
          "description": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "mitigations":{ "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "url":   { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "related": {
      "type": "array",
      "description": "IDs of related catalog entries",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "status": {
      "type": "string",
      "description": "Maturity/state of the abuse primitive",
      "enum": ["active", "partially-mitigated", "mitigated", "patched", "historical"]
    },
    "since": { "type": "string", "minLength": 4 }
  }
}
